# Copy to hevy-sync/env (gitignored). API key from hevy.com/settings?developer (Hevy Pro).
HEVY_API_KEY=your-hevy-pro-api-key
INFLUXDB_URL=http://localhost:8181
INFLUXDB_DATABASE=health
# Shared secret Hevy sends as the Authorization header on webhook calls
# (configured on the webhook subscription; any random string).
HEVY_WEBHOOK_TOKEN=Bearer some-long-random-token
WEBHOOK_PORT=8787
