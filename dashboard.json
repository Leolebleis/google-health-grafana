        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT mean(\"value\") FROM \"HeartRate_Intraday\" WHERE $timeFilter GROUP BY time(5m) fill(none)", "alias": "HR", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
