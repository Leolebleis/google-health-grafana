            {"matcher": {"id": "byName", "options": "REM"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "semi-dark-purple"}}]},
            {"matcher": {"id": "byName", "options": "Light"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "light-blue"}}]}
          ]},
        "targets": [
          {"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"minutesDeep\") FROM \"Sleep Summary\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Deep", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}},
          {"refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"minutesREM\") FROM \"Sleep Summary\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "REM", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}},
          {"refId": "C", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"minutesLight\") FROM \"Sleep Summary\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Light", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}
        ]
      },
      {
        "id": 21, "title": "Sleep Duration", "type": "timeseries",
        "gridPos": {"h": 7, "w": 8, "x": 16, "y": 15},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {"defaults": {"unit": "m", "decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1, "barMaxWidth": 25}, "color": {"mode": "fixed", "fixedColor": "blue"}}},
        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"minutesAsleep\") FROM \"Sleep Summary\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Sleep (min)", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
      },
      {
        "id": 30, "title": "Resting Heart Rate", "type": "timeseries",
