        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT mean(\"value\") FROM \"RestingHR\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "RHR", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
      },
      {
        "id": 31, "title": "HRV", "type": "timeseries",
        "gridPos": {"h": 7, "w": 8, "x": 8, "y": 22},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "fixed", "fixedColor": "purple"}, "custom": {"lineWidth": 2, "pointSize": 4, "showPoints": "always", "spanNulls": true, "fillOpacity": 5}}},
        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT mean(\"dailyRmssd\") FROM \"HRV\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "RMSSD", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
      },
      {
        "id": 32, "title": "SpO2", "type": "timeseries",
        "gridPos": {"h": 7, "w": 8, "x": 16, "y": 22},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {"defaults": {"unit": "percent", "min": 90, "max": 100, "color": {"mode": "fixed", "fixedColor": "blue"}, "custom": {"lineWidth": 2, "pointSize": 4, "showPoints": "always", "spanNulls": true, "fillOpacity": 5}}},
        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT mean(\"avg\") FROM \"SPO2\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "SpO2", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
      },
      {
