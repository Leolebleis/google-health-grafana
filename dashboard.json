      {
        "id": 4,
        "title": "Exercise This Week",
        "type": "gapit-htmlgraphics-panel",
        "gridPos": {
          "h": 8,
          "w": 4,
          "x": 20,
          "y": 0
        },
        "datasource": {
          "type": "influxdb",
          "uid": "P9A8567EC67EE4A5C"
        },
        "targets": [
          {
            "refId": "A",
            "rawQuery": true,
            "resultFormat": "time_series",
            "query": "SELECT count(\"duration\") FROM \"Activity Records\" WHERE \"activityName\" = 'WEIGHTLIFTING' AND time > now() - 7d GROUP BY time(1d) fill(0)",
            "datasource": {
              "type": "influxdb",
              "uid": "P9A8567EC67EE4A5C"
            }
          }
        ],
        "options": {
          "SVGBaseFix": true,
          "add100Percentage": true,
          "centerAlignContent": true,
          "overflow": "hidden",
          "html": "<div id=\"ex\" style=\"width:100%;height:100%;overflow:hidden\"></div>",
          "onRender": "const days=['M','T','W','T','F','S','S'];const c=htmlNode.querySelector('#ex');if(!c)return;let ad=new Set();try{const f=data?.series||[];if(f.length>0&&f[0].fields){const tf=f[0].fields.find(x=>x.name==='Time');const vf=f[0].fields.find(x=>x.name!=='Time');if(tf&&vf){for(let i=0;i<tf.values.length;i++){if(vf.values[i]>0){const d=new Date(tf.values[i]);ad.add(d.getDay())}}}}}catch(e){}const dm=[1,2,3,4,5,6,0];let svg='';for(let i=0;i<7;i++){const a=ad.has(dm[i]);const cx=20+i*36.6;svg+=`<circle cx=\"${cx}\" cy=\"18\" r=\"15\" fill=\"${a?'#69db7c':'#3a3a5a'}\"/>`;svg+=`<text x=\"${cx}\" y=\"22.5\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"${a?'#1a1a2e':'#666'}\">${days[i]}</text>`;}svg+=`<text x=\"130\" y=\"72\" text-anchor=\"middle\" font-size=\"28\" font-weight=\"bold\" fill=\"#69db7c\">${ad.size}<tspan font-size=\"16\" fill=\"#888\" font-weight=\"normal\"> / 7</tspan></text>`;svg+=`<text x=\"130\" y=\"92\" text-anchor=\"middle\" font-size=\"11\" fill=\"#888\">days active</text>`;c.innerHTML=`<svg viewBox=\"0 0 260 100\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\" style=\"display:block\">${svg}</svg>`;"
        }
      },
