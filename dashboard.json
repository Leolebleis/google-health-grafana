{
  "dashboard": {
    "title": "Health",
    "uid": "google-health",
    "timezone": "browser",
    "refresh": "5m",
    "time": {"from": "now-30d", "to": "now"},
    "templating": {"list": []},
    "panels": [
      {
        "id": 1,
        "title": "Weight",
        "type": "stat",
        "gridPos": {"h": 8, "w": 4, "x": 0, "y": 0},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {
          "defaults": {
            "unit": "masskg",
            "decimals": 1,
            "thresholds": {"mode": "absolute", "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 85},
              {"color": "red", "value": 90}
            ]}
          }
        },
        "options": {"graphMode": "none", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"]}},
        "targets": [
          {"refId": "A", "rawQuery": true, "resultFormat": "time_series",
           "query": "SELECT last(\"weight\") FROM \"body_composition\"", "alias": "Current",
           "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}},
          {"refId": "B", "rawQuery": true, "resultFormat": "time_series",
           "query": "SELECT last(\"weight\") - 82 FROM \"body_composition\"", "alias": "To Goal",
           "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}
        ]
      },
      {
        "id": 2,
        "title": "Weight Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 4, "y": 0},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {
          "defaults": {
            "unit": "masskg", "min": 78, "max": 100,
            "custom": {"lineWidth": 2, "pointSize": 6, "showPoints": "always", "spanNulls": true, "fillOpacity": 5, "thresholdsStyle": {"mode": "line"}},
            "color": {"mode": "fixed", "fixedColor": "red"},
            "thresholds": {"mode": "absolute", "steps": [
              {"color": "transparent", "value": null},
              {"color": "green", "value": 82}
            ]}
          }
        },
        "targets": [
          {"refId": "A", "rawQuery": true, "resultFormat": "time_series",
           "query": "SELECT mean(\"weight\") FROM \"body_composition\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Weight",
           "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}
        ]
      },
      {
        "id": 3,
        "title": "Calories This Week",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 12, "y": 0},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {
          "defaults": {
            "unit": "kcal", "decimals": 0,
            "custom": {"drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1, "barMaxWidth": 30, "thresholdsStyle": {"mode": "line+area"}},
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 2300},
              {"color": "red", "value": 2800}
            ]}
          }
        },
        "targets": [
          {"refId": "A", "rawQuery": true, "resultFormat": "time_series",
           "query": "SELECT max(\"value\") FROM \"calories\" WHERE time > now() - 7d GROUP BY time(1d) fill(none)", "alias": "Calories",
           "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}
        ]
      },
      {
        "id": 4,
        "title": "Exercise This Week",
        "type": "gapit-htmlgraphics-panel",
        "gridPos": {"h": 8, "w": 4, "x": 20, "y": 0},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "targets": [
          {"refId": "A", "rawQuery": true, "resultFormat": "time_series",
           "query": "SELECT count(\"duration\") FROM \"Activity Records\" WHERE \"activityName\" = 'WEIGHTLIFTING' AND time > now() - 7d GROUP BY time(1d) fill(0)",
           "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}
        ],
        "options": {
          "SVGBaseFix": true, "add100Percentage": true, "centerAlignContent": true, "overflow": "visible",
          "html": "<div id=\"ex\"></div>",
          "onRender": "const days=['M','T','W','T','F','S','S'];const c=htmlNode.querySelector('#ex');if(!c)return;let ad=new Set();try{const f=data?.series||[];if(f.length>0&&f[0].fields){const tf=f[0].fields.find(x=>x.name==='Time');const vf=f[0].fields.find(x=>x.name!=='Time');if(tf&&vf){for(let i=0;i<tf.values.length;i++){if(vf.values[i]>0){const d=new Date(tf.values[i]);ad.add(d.getDay())}}}}}catch(e){}const dm=[1,2,3,4,5,6,0];let h='<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:12px\">';h+='<div style=\"display:flex;gap:8px\">';for(let i=0;i<7;i++){const a=ad.has(dm[i]);const bg=a?'#69db7c':'#3a3a5a';const fg=a?'#1a1a2e':'#666';h+=`<div style=\"width:30px;height:30px;border-radius:50%;background:${bg};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:bold;color:${fg}\">${days[i]}</div>`}h+='</div>';h+=`<div style=\"text-align:center\"><span style=\"font-size:28px;font-weight:bold;color:#69db7c\">${ad.size}</span><span style=\"font-size:16px;color:#888\"> / 7</span><div style=\"color:#888;font-size:12px;margin-top:2px\">days active</div></div>`;h+='</div>';c.innerHTML=h;"
        }
      },
      {
        "id": 10, "title": "Steps", "type": "timeseries",
        "gridPos": {"h": 7, "w": 8, "x": 0, "y": 8},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 35, "lineWidth": 1, "barMaxWidth": 25}, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 5000}, {"color": "green", "value": 10000}]}}},
        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"value\") FROM \"Total Steps\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Steps", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
      },
      {
        "id": 11, "title": "Activity Minutes", "type": "timeseries",
        "gridPos": {"h": 7, "w": 8, "x": 8, "y": 8},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {"defaults": {"unit": "m", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}, "fillOpacity": 50, "lineWidth": 0, "barMaxWidth": 25}},
          "overrides": [
            {"matcher": {"id": "byName", "options": "Light"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
            {"matcher": {"id": "byName", "options": "Moderate"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
            {"matcher": {"id": "byName", "options": "Intense"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
          ]},
        "targets": [
          {"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"minutesLightlyActive\") FROM \"Activity Minutes\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Light", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}},
          {"refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"minutesFairlyActive\") FROM \"Activity Minutes\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Moderate", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}},
          {"refId": "C", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"minutesVeryActive\") FROM \"Activity Minutes\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "Intense", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}
        ]
      },
      {
        "id": 12, "title": "Distance", "type": "timeseries",
        "gridPos": {"h": 7, "w": 8, "x": 16, "y": 8},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {"defaults": {"unit": "km", "decimals": 1, "custom": {"drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1, "barMaxWidth": 25}, "color": {"mode": "fixed", "fixedColor": "blue"}}},
        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT max(\"value\") / 1000 FROM \"distance\" WHERE $timeFilter GROUP BY time(1d) fill(none)", "alias": "km", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
      },
      {
        "id": 20, "title": "Sleep Stages", "type": "timeseries",
        "gridPos": {"h": 7, "w": 16, "x": 0, "y": 15},
        "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"},
        "fieldConfig": {"defaults": {"unit": "m", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}, "fillOpacity": 60, "lineWidth": 0, "barMaxWidth": 25}},
