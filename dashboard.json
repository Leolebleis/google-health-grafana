        "targets": [{"refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT mean(\"body_fat_pct\") FROM \"body_composition\" WHERE $timeFilter AND \"body_fat_pct\" > 0 GROUP BY time(1d) fill(none)", "alias": "Body Fat %", "datasource": {"type": "influxdb", "uid": "P9A8567EC67EE4A5C"}}]
