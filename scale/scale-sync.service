[Unit]
Description=Xiaomi cloud scale sync (SmartScaleConnect -> InfluxDB)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=leo
WorkingDirectory=/home/leo/documents/code/raspberrypi/google-health-grafana
ExecStart=/home/leo/documents/code/raspberrypi/google-health-grafana/.venv/bin/python -m scale.cloud_sync
Environment=PYTHONPATH=/home/leo/documents/code/raspberrypi/google-health-grafana
